  "cards": [
    {
      "dot": "cyan",
      "title": "Phase 0 只回答一个问题",
      "items": [
        "\\x1bP1000p 能否活着穿过 TerminalOutputDecoder 与 OscStripper 到达前端",
        "拦截点放在 core/ssh/io.rs 的哪一层最干净",
        "拦下之后，原会话能否无损退回普通终端"
      ]
    },
    {
      "dot": "amber",
      "title": "协议不值钱，集成面值钱",
      "items": [
        "控制模式协议公开稳定，已有 5 个以上开源实现可对照",
        "真正的成本是给每一层加第二根身份轴：tmux pane-id",
        "所有解析会话字节流的功能都要重新指向 per-pane 解码流"
      ]
    },
    {
      "dot": "emerald",
      "title": "Phase 0 的出口",
      "items": [
        "过了：后面是工作量已知的体力活，可按 MVP 分阶段推进",
        "没过：用 2 天而不是 2 个月知道这件事",
        "回写路径由 send-keys / resize-pane 命令回到远端 tmux"
      ]
    }
  ]
}
